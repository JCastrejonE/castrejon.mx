---
// The address is written to the HTML reversed and split; the script reassembles it into a mailto link.
// Without JavaScript the contact cell has no href, so it reads as plain text instead of a dead link;
// the header link falls back to the contact section. The script lives in EmailScript.astro, included once per page.
import { site } from '../data/site';

interface Props {
  variant?: 'cell' | 'inline';
  class?: string;
}
const { variant = 'cell', class: className = 'contact-link' } = Astro.props;
const reverse = (s: string) => [...s].reverse().join('');
const [user, domain] = site.contact.email.split('@').map(reverse);
---

{
  variant === 'cell' ? (
    <a class="cell cell-link" data-email data-u={user} data-d={domain}>
      <span class="cell-label">{site.labels.email}</span>
      <span class="cell-value" data-email-text>{site.contact.emailFallback}</span>
    </a>
  ) : (
    <a class={className} href="#contact" data-email data-u={user} data-d={domain}>{site.labels.email}</a>
  )
}
