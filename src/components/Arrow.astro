---
// Direction arrow drawn in currentColor, so it looks the same on every platform and in forced-colors mode.
// "out" leaves the site, "down" downloads, "back" returns to the parent page (a chevron, as in a navigation bar).
// The paths are defined once per page in ArrowDefs.astro (included by Base.astro), which keeps the home page light.
interface Props {
  dir?: 'out' | 'down' | 'back';
}
const { dir = 'out' } = Astro.props;
---

<svg class:list={['arrow', `arrow-${dir}`]} aria-hidden="true"><use href={`#i-${dir}`} /></svg>
