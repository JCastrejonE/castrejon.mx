---
import '../styles/global.css';
import ArrowDefs from '../components/ArrowDefs.astro';
import { getSite, other, HREFLANG, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  // This page's path in its own language, e.g. '/es/research/'.
  path?: string;
  // The same page's path in the other language, when it exists. Adds the hreflang alternates and og:locale:alternate.
  alternate?: string;
  noindex?: boolean;
  // 'profile' for the home page; 'article' for research essays, whose page adds its own article meta in the "head" slot.
  ogType?: 'profile' | 'website' | 'article';
  // Structured data for this page; the home page uses the Person below.
  jsonld?: Record<string, unknown>;
}

const { lang = 'en' } = Astro.props;
const site = getSite(lang);
const {
  title = site.title,
  description = site.description,
  path = site.paths.home,
  alternate,
  noindex = false,
  ogType = 'profile',
  jsonld,
} = Astro.props;
const abs = (p: string) => new URL(p, site.url).href;
const canonical = abs(path);
const ogImage = abs(site.ogImage);
const ogAlt = `${site.name}. ${site.ogLines.join(' ')}`;
const otherSite = getSite(other(lang));
// hreflang alternates for a page that exists in both languages; English is the default.
const alternates = alternate
  ? [
      { hreflang: HREFLANG[lang], href: canonical },
      { hreflang: HREFLANG[other(lang)], href: abs(alternate) },
      { hreflang: 'x-default', href: abs(lang === 'en' ? path : alternate) },
    ]
  : [];

const person = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  inLanguage: site.lang,
  mainEntity: {
    '@type': 'Person',
    name: site.name,
    jobTitle: site.person.jobTitle,
    worksFor: { '@type': 'Organization', ...site.person.worksFor },
    url: site.url,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Zapopan',
      addressRegion: 'Jalisco',
      addressCountry: 'MX',
    },
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidad Nacional Autónoma de México' },
    sameAs: [site.contact.github.href, site.contact.linkedin.href],
  },
};
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <link rel="preload" href="/fonts/newsreader-display-600.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    {
      !noindex && (
        <>
        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content={site.name} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogAlt} />
        <meta property="og:locale" content={site.locale} />
        {alternate && <meta property="og:locale:alternate" content={otherSite.locale} />}
        {ogType === 'profile' && <meta property="profile:first_name" content="Juan Carlos" />}
        {ogType === 'profile' && <meta property="profile:last_name" content="Castrejón Estrada" />}
        <slot name="head" />
        {/* X reads title, description and image from the og: tags above. */}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image:alt" content={ogAlt} />
        <script type="application/ld+json" set:html={JSON.stringify(jsonld ?? person)} />
        </>
      )
    }
  </head>
  <body>
    <slot />
    <ArrowDefs />
  </body>
</html>
